# Copy this file to ".env" and fill in real values.
# Never commit the real .env file to git.

# LLM_PROVIDER: "mock" (default, no key needed), "openai", "gemini", or "claude"
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

PORT=8000
DATABASE_URL="postgresql://postgres:password@localhost:5432/mindflow_db"
JWT_SECRET="super_secret_jwt_key_change_this_12345"
